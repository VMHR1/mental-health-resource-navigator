{
  "name": "mental-health-resource-navigator",
  "version": "1.0.0",
  "description": "Neutral post-discharge mental health resource navigator for Dallas-Fort Worth area youth",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "build:admin": "INCLUDE_ADMIN=1 node scripts/build.js",
    "dev": "node scripts/build.js --watch",
    "preview": "npm run build && npx http-server dist -p 4173 -c-1",
    "preview:serve": "npx http-server dist -p 4173 -c-1",
    "preview:8080": "npm run build && npx http-server dist -p 8080 -c-1",
    "minify": "node scripts/build.js --minify",
    "validate-filters": "node scripts/validate-filters.js",
    "validate-data": "node scripts/validate-data.js",
    "sync-regional-data": "node scripts/sync-regional-data.js",
    "verify-all-programs": "node scripts/verify-all-programs.js",
    "verify-all-programs:force": "node scripts/verify-all-programs.js --force",
    "spot-check-attention": "node scripts/spot-check-25.js",
    "apply-attention-fixes": "node scripts/apply-may-2026-attention-fixes.js",
    "audit-program-data": "node scripts/audit-program-data.js --force",
    "apply-internet-verification": "node scripts/apply-internet-verification-may2026.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:update:linux": "docker run --rm -v $(pwd):/workspace -w /workspace mcr.microsoft.com/playwright:v1.40.0-focal /bin/bash -c \"npm install && npx playwright install chromium firefox webkit && npm run build && npx playwright test --update-snapshots\"",
    "test:mobile": "playwright test --project=mobile --project=mobile-webkit",
    "audit": "lhci autorun --config=lighthouserc.json",
    "verify": "env -u PLAYWRIGHT_BROWSERS_PATH sh -c 'npm run build && npm run validate-data && npm run validate-filters && npm run test:e2e && npm run audit'",
    "audit:search": "node scripts/audit-search-localhost.mjs",
    "audit:insurance": "node scripts/audit-insurance-plans.mjs",
    "smoke:prod": "node scripts/prod-smoke.mjs",
    "push:deploy": "git push origin HEAD:updated-main"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.40.0",
    "esbuild": "^0.27.2",
    "http-server": "^14.1.1"
  },
  "overrides": {
    "tmp": "^0.2.5"
  },
  "keywords": [
    "mental-health",
    "resource-navigator",
    "dallas",
    "texas"
  ],
  "author": "",
  "license": "MIT"
}
